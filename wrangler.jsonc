{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iframe",
  "main": ".vinext/worker/index.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "initlabel.com",
      "custom_domain": true
    }
  ]
}
